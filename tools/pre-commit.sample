#!/bin/sh
# 余量 MARGIN — git pre-commit 钩子（示例）
#
# 作用：提交前校验「生成产物」是否与 tools/ 下的源一致。
# 如果忘了跑构建就提交，这里会拦下来——这是这套流程里最容易犯的错。
#
# 启用方式（在仓库根目录执行）：
#   cp tools/pre-commit.sample .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# 临时跳过（不推荐）：git commit --no-verify

fail=0

echo "[pre-commit] 校验内容产物（build.mjs）…"
node tools/build.mjs --check
[ $? -ne 0 ] && fail=1

echo "[pre-commit] 校验反爬产物（build-traps.mjs）…"
node tools/build-traps.mjs --check
[ $? -ne 0 ] && fail=1

if [ $fail -ne 0 ]; then
  echo ""
  echo "──────────────────────────────────────────────"
  echo " 提交被阻止：上面的文件与 tools/ 下的源不一致。"
  echo " 修复方式："
  echo "   node tools/build.mjs"
  echo "   node tools/build-traps.mjs"
  echo "──────────────────────────────────────────────"
  exit 1
fi

echo "[pre-commit] 全部一致。"
exit 0
